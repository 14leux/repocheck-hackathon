# RepoCheck hackathon -- local secrets template.
#
# Copy this file to .env (already git-ignored -- see .gitignore) and fill
# in real values there. Never put real values in THIS file: .env.example
# is tracked by git and meant to document the shape, not hold secrets.
#
# Loaded automatically by envfile.py the moment a script needs one of
# these -- no shell export needed, and nothing here ever needs to be
# pasted into a chat message. A real environment variable (e.g. one set
# with `setx` or `export`) always takes precedence over this file.

# Required for deep_scan.py / verify_deep_scan.py (the opt-in LLM pass).
# Get one at https://console.anthropic.com/settings/keys -- for a
# one-off hackathon key, give it a short expiration there (e.g. 1 day)
# and confirm the org is NOT zero-data-retention (Fable 5.1 requires
# 30-day retention; a ZDR org gets a 400 on every request).
ANTHROPIC_API_KEY=

# Optional. Avoids GitHub's low unauthenticated rate limit when scanning
# many repos in one session. No scopes needed for public repos.
# https://github.com/settings/tokens
GITHUB_TOKEN=
